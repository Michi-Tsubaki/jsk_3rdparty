<launch>
  <arg name="host" default="$(env VOICEVOX_TEXTTOSPEECH_URL localhost)" />
  <arg name="port" default="$(env VOICEVOX_TEXTTOSPEECH_PORT 50021)" />
  <arg name="default_speaker" default="$(env VOICEVOX_DEFAULT_SPEAKER_ID 2)" />
  <arg name="remote_only" default="false" />
  <arg name="use_docker" default="false" />
  <arg name="cpu_num_threads" default="1" />
  <arg name="text_topic" default="/robotsound_jp" />
  <arg name="audio_topic" default="/audio" />
  <arg name="audio_info_topic" default="/audio_info" />
  <arg name="sample_rate" default="16000" />
  <arg name="volume_scale" default="10.0" />

  <include file="$(find-pkg-share voicevox)/launch/voicevox_texttospeech.launch.xml">
    <arg name="host" value="$(var host)" />
    <arg name="port" value="$(var port)" />
    <arg name="remote_only" value="$(var remote_only)" />
    <arg name="use_docker" value="$(var use_docker)" />
    <arg name="cpu_num_threads" value="$(var cpu_num_threads)" />
    <arg name="launch_sound_play" value="false" />
  </include>
  <node pkg="voicevox" exec="voicevox_audio.py" name="voicevox_audio" output="screen">
    <param name="host" value="$(var host)" type="str" />
    <param name="port" value="$(var port)" type="int" />
    <param name="speaker" value="$(var default_speaker)" type="int" />
    <param name="sample_rate" value="$(var sample_rate)" type="int" />
    <param name="volume_scale" value="$(var volume_scale)" type="float" />
    <remap from="text" to="$(var text_topic)" />
    <remap from="audio" to="$(var audio_topic)" />
    <remap from="audio_info" to="$(var audio_info_topic)" />
  </node>
</launch>
