<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motion_instruction</name>
  <version>0.0.0</version>
  <description>Natural-language relative Cartesian motion instruction nodes for ROS 2 and Roseus.</description>
  <maintainer email="tsubaki@jsk.t.u-tokyo.ac.jp">tsubaki</maintainer>
  <license>BSD</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>action_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>motion_instruction_interfaces</depend>
  <exec_depend>sound_play_msgs</exec_depend>
  <exec_depend>voicevox</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>ros_speech_recognition</exec_depend>
  <exec_depend>python3-openai</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
